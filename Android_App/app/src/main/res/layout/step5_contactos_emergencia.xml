<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/layoutStep5"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:visibility="gone">

    <!-- Section Title: Contactos de Emergencia -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="4dp">
        <ImageView
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:src="@android:drawable/ic_menu_call"
            android:tint="#F44336"
            android:layout_marginEnd="8dp" />
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Contactos de Emergencia"
            android:textSize="20sp"
            android:textStyle="bold"
            android:textColor="#263238" />
    </LinearLayout>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Agregue hasta 3 contactos que serán notificados en caso de emergencia."
        android:textSize="13sp"
        android:textColor="#78909C"
        android:layout_marginBottom="20dp" />

    <!-- Contact Cards Container (dynamic) -->
    <LinearLayout
        android:id="@+id/contactCardsContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical" />

    <!-- Add Contact Button -->
    <LinearLayout
        android:id="@+id/btnAddContact"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center"
        android:background="@drawable/bg_add_contact_dashed"
        android:padding="16dp"
        android:layout_marginTop="12dp"
        android:clickable="true"
        android:focusable="true">
        <ImageView
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:src="@android:drawable/ic_input_add"
            android:tint="#00BFA5"
            android:layout_marginEnd="8dp" />
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Agregar Contacto de Emergencia"
            android:textSize="14sp"
            android:textColor="#00BFA5"
            android:textStyle="bold" />
    </LinearLayout>

</LinearLayout>
