<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F7FAFA"
    android:orientation="vertical"
    android:paddingStart="24dp"
    android:paddingTop="48dp"
    android:paddingEnd="24dp"
    android:paddingBottom="32dp">

    <!-- Segmented Step Progress Section -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        android:layout_marginTop="16dp"
        android:layout_marginBottom="36dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="PASO 3 DE 3"
            android:textColor="#00796B"
            android:textSize="13sp"
            android:textStyle="bold"
            android:letterSpacing="0.05"
            android:layout_marginBottom="10dp" />

        <!-- 3 Segment Bars (All 3 active for Step 3) -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center">

            <View
                android:layout_width="44dp"
                android:layout_height="5dp"
                android:background="@drawable/bg_segment_active"
                android:layout_marginEnd="6dp" />

            <View
                android:layout_width="44dp"
                android:layout_height="5dp"
                android:background="@drawable/bg_segment_active"
                android:layout_marginEnd="6dp" />

            <View
                android:layout_width="44dp"
                android:layout_height="5dp"
                android:background="@drawable/bg_segment_active" />
        </LinearLayout>
    </LinearLayout>

    <!-- Central Watch Icon Circle -->
    <FrameLayout
        android:layout_width="120dp"
        android:layout_height="120dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginBottom="36dp"
        android:background="@drawable/bg_circle_icon">

        <ImageView
            android:layout_width="60dp"
            android:layout_height="60dp"
            android:layout_gravity="center"
            android:contentDescription="Reloj"
            android:src="@drawable/reloj"
            app:tint="#00796B" />
    </FrameLayout>

    <!-- Main Title -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:layout_marginBottom="14dp"
        android:gravity="center"
        android:text="¡SafeBand añadida con\néxito!"
        android:textColor="#11181C"
        android:textSize="26sp"
        android:textStyle="bold"
        android:lineSpacingExtra="3dp" />

    <!-- Subtitle / Message -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:gravity="center"
        android:lineSpacingExtra="5dp"
        android:text="Has añadido tu SafeBand exitosamente.\nAhora puedes empezar a monitorear la\ndetección de caídas."
        android:textColor="#64748B"
        android:textSize="16sp" />

    <View
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <!-- Action Button -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnVerDispositivos"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:text="Ver mi SafeBand →"
        android:textAllCaps="false"
        android:textColor="#FFFFFF"
        android:textSize="17sp"
        android:textStyle="bold"
        app:backgroundTint="#00796B"
        app:cornerRadius="28dp"
        app:elevation="2dp" />

</LinearLayout>
