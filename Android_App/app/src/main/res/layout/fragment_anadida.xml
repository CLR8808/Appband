<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_main"
    android:orientation="vertical"
    android:paddingStart="24dp"
    android:paddingTop="54dp"
    android:paddingEnd="24dp"
    android:paddingBottom="40dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="center"
        android:orientation="vertical">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:gravity="center"
            android:text="¡Safeband añadida con éxito!"
            android:textColor="@color/text_primary"
            android:textSize="24sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="32dp"
            android:gravity="center"
            android:lineSpacingExtra="4dp"
            android:text="Has añadido tu Safeband exitosamente.\nAhora puedes empezar a monitorear\nla detección de caídas."
            android:textColor="@color/text_muted"
            android:textSize="15sp" />

        <ImageView
            android:layout_width="260dp"
            android:layout_height="260dp"
            android:contentDescription="Safeband"
            android:scaleType="fitCenter"
            android:src="@drawable/safeband" />

    </LinearLayout>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnVerDispositivos"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:background="@drawable/bg_primary_button"
        android:text="Ver dispositivos"
        android:textColor="@color/white"
        android:textSize="17sp"
        android:textStyle="bold"
        app:backgroundTint="@null"
        app:cornerRadius="14dp"
        app:elevation="6dp" />

</LinearLayout>
