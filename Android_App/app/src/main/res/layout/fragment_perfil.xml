<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_main"
    android:orientation="vertical">

    <!-- Sticky Top Segment / TabLayout -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/bg_main"
        android:paddingStart="24dp"
        android:paddingTop="48dp"
        android:paddingEnd="24dp"
        android:paddingBottom="12dp">

        <com.google.android.material.tabs.TabLayout
            android:id="@+id/tabLayoutPerfil"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:background="@drawable/bg_input_container"
            app:tabGravity="fill"
            app:tabIndicatorColor="@color/primary_teal"
            app:tabIndicatorFullWidth="false"
            app:tabIndicatorGravity="bottom"
            app:tabIndicatorHeight="3dp"
            app:tabMode="fixed"
            app:tabPaddingEnd="16dp"
            app:tabPaddingStart="16dp"
            app:tabRippleColor="@null"
            app:tabSelectedTextColor="@color/primary_teal"
            app:tabTextColor="@color/text_muted">

            <com.google.android.material.tabs.TabItem
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:icon="@drawable/ic_person"
                android:text="Perfil" />

            <com.google.android.material.tabs.TabItem
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:icon="@drawable/ic_heart"
                android:text="Paciente" />

        </com.google.android.material.tabs.TabLayout>
    </LinearLayout>

    <!-- Scrollable Content -->
    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <!-- Container Pestaña PERFIL -->
            <LinearLayout
                android:id="@+id/containerPerfilTab"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="24dp"
                android:paddingTop="12dp"
                android:paddingEnd="24dp"
                android:paddingBottom="120dp"
                android:visibility="visible">

                <!-- Main Title -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="24dp"
                    android:text="Perfil"
                    android:textColor="@color/text_primary"
                    android:textSize="28sp"
                    android:textStyle="bold" />

                <!-- Profile Header Card (Avatar, Name, Email) -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="32dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <RelativeLayout
                        android:layout_width="72dp"
                        android:layout_height="72dp"
                        android:layout_marginEnd="18dp">

                        <ImageView
                            android:id="@+id/ivAvatar"
                            android:layout_width="72dp"
                            android:layout_height="72dp"
                            android:background="@drawable/bg_input_container"
                            android:contentDescription="Avatar"
                            android:padding="14dp"
                            android:scaleType="centerCrop"
                            android:src="@drawable/ic_person"
                            app:tint="@color/primary_teal" />

                        <ImageView
                            android:layout_width="26dp"
                            android:layout_height="26dp"
                            android:layout_alignParentEnd="true"
                            android:layout_alignParentBottom="true"
                            android:background="@drawable/bg_primary_button"
                            android:contentDescription="Edit"
                            android:padding="5dp"
                            android:src="@drawable/ic_person"
                            app:tint="@color/white" />
                    </RelativeLayout>

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/tvUserName"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="4dp"
                            android:textColor="@color/text_primary"
                            android:textSize="20sp"
                            android:textStyle="bold"
                            tools:text="Usuario SafeStep" />

                        <TextView
                            android:id="@+id/tvUserEmail"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textColor="@color/text_muted"
                            android:textSize="14sp"
                            tools:text="usuario@safestep.com" />
                    </LinearLayout>

                </LinearLayout>

                <!-- Section General -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="12dp"
                    android:letterSpacing="0.08"
                    android:text="GENERAL"
                    android:textColor="@color/text_hint"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <include
                    android:id="@+id/cardDetallesUsuario"
                    layout="@layout/layout_option_card" />

                <!-- Section Preferencias -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:layout_marginBottom="12dp"
                    android:letterSpacing="0.08"
                    android:text="PREFERENCIAS"
                    android:textColor="@color/text_hint"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <include
                    android:id="@+id/cardNotificaciones"
                    layout="@layout/layout_option_card" />

                <include
                    android:id="@+id/cardUbicacionPref"
                    layout="@layout/layout_option_card" />

                <include
                    android:id="@+id/cardWifiPref"
                    layout="@layout/layout_option_card" />

                <!-- Section Ayuda -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:layout_marginBottom="12dp"
                    android:letterSpacing="0.08"
                    android:text="AYUDA"
                    android:textColor="@color/text_hint"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <include
                    android:id="@+id/cardSoporte"
                    layout="@layout/layout_option_card" />

                <!-- Spacer & Logout Card -->
                <View
                    android:layout_width="match_parent"
                    android:layout_height="14dp" />

                <include
                    android:id="@+id/cardCerrarSesion"
                    layout="@layout/layout_option_card" />

            </LinearLayout>

            <!-- Container Pestaña PACIENTE (Formulario) -->
            <FrameLayout
                android:id="@+id/containerPacienteTab"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:visibility="gone" />

        </FrameLayout>

    </androidx.core.widget.NestedScrollView>

</LinearLayout>
