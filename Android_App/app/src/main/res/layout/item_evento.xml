<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/cardContainer"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="14dp"
    android:background="@drawable/bg_incident_warning"
    android:orientation="horizontal">

    <!-- Left Thick Color Bar -->
    <View
        android:id="@+id/viewIndicatorBar"
        android:layout_width="6dp"
        android:layout_height="match_parent"
        android:background="@drawable/bg_indicator_warning" />

    <!-- Content Area -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- Top Row: Circle Icon Container -->
        <FrameLayout
            android:id="@+id/frameIconContainer"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:layout_marginBottom="12dp"
            android:background="@drawable/bg_circle_icon"
            android:backgroundTint="#FEF3C7">

            <ImageView
                android:id="@+id/ivIncidentIcon"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_gravity="center"
                android:contentDescription="Tipo de incidente"
                android:src="@drawable/ic_warning"
                app:tint="#D97706" />
        </FrameLayout>

        <!-- Badge + Time Row -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tvBadge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_badge_warning"
                android:paddingStart="10dp"
                android:paddingTop="3dp"
                android:paddingEnd="10dp"
                android:paddingBottom="3dp"
                android:textColor="#D97706"
                android:textSize="11sp"
                android:textStyle="bold"
                tools:text="ADVERTENCIA" />

            <ImageView
                android:layout_width="14dp"
                android:layout_height="14dp"
                android:layout_marginStart="8dp"
                android:layout_marginEnd="4dp"
                android:src="@drawable/ic_time"
                app:tint="#64748B" />

            <TextView
                android:id="@+id/tvTime"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="#64748B"
                android:textSize="12sp"
                tools:text="Hace 25 minutos" />
        </LinearLayout>

        <!-- Title -->
        <TextView
            android:id="@+id/tvIncidentTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="6dp"
            android:textColor="#0F172A"
            android:textSize="17sp"
            android:textStyle="bold"
            tools:text="POSIBLE CAÍDA DETECTADA" />

        <!-- Description -->
        <TextView
            android:id="@+id/tvIncidentDesc"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="14dp"
            android:textColor="#475569"
            android:textSize="13sp"
            tools:text="Impacto o cambio brusco de altitud detectado." />

        <!-- Action Button -->
        <TextView
            android:id="@+id/btnIncidentAction"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_btn_warning"
            android:clickable="true"
            android:focusable="true"
            android:paddingStart="22dp"
            android:paddingTop="10dp"
            android:paddingEnd="22dp"
            android:paddingBottom="10dp"
            android:textColor="#00796B"
            android:textSize="13sp"
            android:textStyle="bold"
            tools:text="Ver información" />
    </LinearLayout>

</LinearLayout>
