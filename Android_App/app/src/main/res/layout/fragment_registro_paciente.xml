<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F5F7FA"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- ═══════════════════════════════════════════ -->
        <!-- HEADER: PASO X DE 7                        -->
        <!-- ═══════════════════════════════════════════ -->
        <TextView
            android:id="@+id/tvStepHeader"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:text="PASO 1 DE 7"
            android:textColor="#00BFA5"
            android:textSize="13sp"
            android:textStyle="bold"
            android:fontFamily="sans-serif-medium"
            android:letterSpacing="0.1"
            android:layout_marginBottom="12dp" />

        <!-- ═══════════════════════════════════════════ -->
        <!-- STEP INDICATOR ROW (7 circles + lines)     -->
        <!-- ═══════════════════════════════════════════ -->
        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:scrollbars="none"
            android:layout_marginBottom="20dp">

            <LinearLayout
                android:id="@+id/stepIndicatorRow"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_gravity="center_horizontal">

                <!-- Step 1 -->
                <FrameLayout
                    android:id="@+id/step1Circle"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:background="@drawable/bg_step_active">
                    <ImageView
                        android:layout_width="18dp"
                        android:layout_height="18dp"
                        android:layout_gravity="center"
                        android:src="@android:drawable/ic_menu_myplaces"
                        android:tint="#FFFFFF" />
                </FrameLayout>
                <View android:id="@+id/line1_2" android:layout_width="28dp" android:layout_height="2dp" android:background="@drawable/bg_step_line" />

                <!-- Step 2 -->
                <FrameLayout
                    android:id="@+id/step2Circle"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:background="@drawable/bg_step_inactive">
                    <ImageView
                        android:layout_width="18dp"
                        android:layout_height="18dp"
                        android:layout_gravity="center"
                        android:src="@android:drawable/ic_menu_today"
                        android:tint="#90A4AE" />
                </FrameLayout>
                <View android:id="@+id/line2_3" android:layout_width="28dp" android:layout_height="2dp" android:background="@drawable/bg_step_line" />

                <!-- Step 3 -->
                <FrameLayout
                    android:id="@+id/step3Circle"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:background="@drawable/bg_step_inactive">
                    <ImageView
                        android:layout_width="18dp"
                        android:layout_height="18dp"
                        android:layout_gravity="center"
                        android:src="@android:drawable/ic_dialog_alert"
                        android:tint="#90A4AE" />
                </FrameLayout>
                <View android:id="@+id/line3_4" android:layout_width="28dp" android:layout_height="2dp" android:background="@drawable/bg_step_line" />

                <!-- Step 4 -->
                <FrameLayout
                    android:id="@+id/step4Circle"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:background="@drawable/bg_step_inactive">
                    <ImageView
                        android:layout_width="18dp"
                        android:layout_height="18dp"
                        android:layout_gravity="center"
                        android:src="@android:drawable/ic_menu_my_calendar"
                        android:tint="#90A4AE" />
                </FrameLayout>
                <View android:id="@+id/line4_5" android:layout_width="28dp" android:layout_height="2dp" android:background="@drawable/bg_step_line" />

                <!-- Step 5 -->
                <FrameLayout
                    android:id="@+id/step5Circle"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:background="@drawable/bg_step_inactive">
                    <ImageView
                        android:layout_width="18dp"
                        android:layout_height="18dp"
                        android:layout_gravity="center"
                        android:src="@android:drawable/ic_menu_call"
                        android:tint="#90A4AE" />
                </FrameLayout>
                <View android:id="@+id/line5_6" android:layout_width="28dp" android:layout_height="2dp" android:background="@drawable/bg_step_line" />

                <!-- Step 6 -->
                <FrameLayout
                    android:id="@+id/step6Circle"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:background="@drawable/bg_step_inactive">
                    <ImageView
                        android:layout_width="18dp"
                        android:layout_height="18dp"
                        android:layout_gravity="center"
                        android:src="@android:drawable/ic_menu_manage"
                        android:tint="#90A4AE" />
                </FrameLayout>
                <View android:id="@+id/line6_7" android:layout_width="28dp" android:layout_height="2dp" android:background="@drawable/bg_step_line" />

                <!-- Step 7 -->
                <FrameLayout
                    android:id="@+id/step7Circle"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:background="@drawable/bg_step_inactive">
                    <ImageView
                        android:layout_width="18dp"
                        android:layout_height="18dp"
                        android:layout_gravity="center"
                        android:src="@android:drawable/ic_menu_send"
                        android:tint="#90A4AE" />
                </FrameLayout>

            </LinearLayout>
        </HorizontalScrollView>

        <!-- ═══════════════════════════════════════════════════════ -->
        <!-- CARD CONTAINER: holds current step form inside a card  -->
        <!-- ═══════════════════════════════════════════════════════ -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardCornerRadius="16dp"
            app:cardElevation="4dp"
            app:strokeWidth="0dp"
            android:layout_marginBottom="16dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp">

                <!-- FrameLayout to swap step content -->
                <FrameLayout
                    android:id="@+id/stepContentContainer"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                    <!-- ═════════════════════════════════════════════════ -->
                    <!-- PASO 1: Datos del Paciente                       -->
                    <!-- ═════════════════════════════════════════════════ -->
                    <include layout="@layout/step1_datos_paciente" />

                    <!-- PASO 2: Información Médica -->
                    <include layout="@layout/step2_info_medica" />

                    <!-- PASO 3: Umbrales de Alerta -->
                    <include layout="@layout/step3_umbrales_alerta" />

                    <!-- PASO 4: Tutor / Familiar -->
                    <include layout="@layout/step4_tutor_familiar" />

                    <!-- PASO 5: Contactos de Emergencia -->
                    <include layout="@layout/step5_contactos_emergencia" />

                    <!-- PASO 6: Configuración de Alertas -->
                    <include layout="@layout/step6_config_alertas" />

                    <!-- PASO 7: Resumen Final -->
                    <include layout="@layout/step7_resumen" />

                </FrameLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- ═══════════════════════════════════════════ -->
        <!-- NAVIGATION BUTTONS                         -->
        <!-- ═══════════════════════════════════════════ -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center"
            android:layout_marginBottom="24dp">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnAnterior"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:text="← Anterior"
                android:textAllCaps="false"
                android:textSize="14sp"
                android:visibility="gone"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                app:cornerRadius="12dp"
                app:strokeColor="#00BFA5"
                android:textColor="#00BFA5"
                android:layout_marginEnd="8dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnSiguiente"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:text="Guardar y Continuar →"
                android:textAllCaps="false"
                android:textSize="14sp"
                app:cornerRadius="12dp"
                app:backgroundTint="#00BFA5"
                android:textColor="#FFFFFF"
                android:layout_marginStart="8dp" />

        </LinearLayout>

    </LinearLayout>
</androidx.core.widget.NestedScrollView>
