<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/layoutStep6"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:visibility="gone">

    <!-- Section Title: Configuración de Alertas -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="4dp">
        <ImageView
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:src="@android:drawable/ic_menu_manage"
            android:tint="#00796B"
            android:layout_marginEnd="8dp" />
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Configuración de Alertas"
            android:textSize="20sp"
            android:textStyle="bold"
            android:textColor="#11181C" />
    </LinearLayout>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Personaliza cómo y cuándo recibir alertas"
        android:textSize="13sp"
        android:textColor="#64748B"
        android:layout_marginBottom="20dp" />

    <!-- Modo de alerta -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Modo de Alerta"
        android:textSize="15sp"
        android:textStyle="bold"
        android:textColor="#11181C"
        android:layout_marginBottom="10dp" />

    <RadioGroup
        android:id="@+id/radioGroupModoAlerta"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_marginBottom="16dp">

        <RadioButton
            android:id="@+id/radioSonido"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="  Sonido y Vibración"
            android:textSize="15sp"
            android:textColor="#11181C"
            android:padding="12dp"
            android:background="@drawable/bg_contact_card"
            android:layout_marginBottom="6dp"
            android:buttonTint="#00796B"
            android:checked="true" />

        <RadioButton
            android:id="@+id/radioVibracion"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="  Solo Vibración"
            android:textSize="15sp"
            android:textColor="#11181C"
            android:padding="12dp"
            android:background="@drawable/bg_contact_card"
            android:layout_marginBottom="6dp"
            android:buttonTint="#00796B" />

        <RadioButton
            android:id="@+id/radioSilencioso"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="  Silencioso (solo visual)"
            android:textSize="15sp"
            android:textColor="#11181C"
            android:padding="12dp"
            android:background="@drawable/bg_contact_card"
            android:layout_marginBottom="6dp"
            android:buttonTint="#00796B" />
    </RadioGroup>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#E2E8F0"
        android:layout_marginBottom="16dp" />

    <!-- Notificaciones toggle switches -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Tipos de Notificación"
        android:textSize="15sp"
        android:textStyle="bold"
        android:textColor="#11181C"
        android:layout_marginBottom="10dp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="@drawable/bg_contact_card"
        android:padding="14dp"
        android:layout_marginBottom="8dp">
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Alerta por Pulso Anormal"
                android:textSize="14sp"
                android:textColor="#11181C" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Notificar cuando el pulso salga de rango"
                android:textSize="11sp"
                android:textColor="#64748B" />
        </LinearLayout>
        <com.google.android.material.switchmaterial.SwitchMaterial
            android:id="@+id/switchAlertaPulso"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:checked="true" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="@drawable/bg_contact_card"
        android:padding="14dp"
        android:layout_marginBottom="8dp">
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Alerta por Caída Detectada"
                android:textSize="14sp"
                android:textColor="#11181C" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Notificar cuando se detecte una caída"
                android:textSize="11sp"
                android:textColor="#64748B" />
        </LinearLayout>
        <com.google.android.material.switchmaterial.SwitchMaterial
            android:id="@+id/switchAlertaCaida"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:checked="true" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="@drawable/bg_contact_card"
        android:padding="14dp"
        android:layout_marginBottom="8dp">
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Alerta por Inactividad"
                android:textSize="14sp"
                android:textColor="#11181C" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Notificar si no hay movimiento prolongado"
                android:textSize="11sp"
                android:textColor="#64748B" />
        </LinearLayout>
        <com.google.android.material.switchmaterial.SwitchMaterial
            android:id="@+id/switchAlertaInactividad"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:checked="false" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="@drawable/bg_contact_card"
        android:padding="14dp"
        android:layout_marginBottom="8dp">
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Enviar Ubicación GPS"
                android:textSize="14sp"
                android:textColor="#11181C" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Incluir ubicación en alertas de emergencia"
                android:textSize="11sp"
                android:textColor="#64748B" />
        </LinearLayout>
        <com.google.android.material.switchmaterial.SwitchMaterial
            android:id="@+id/switchEnviarGPS"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:checked="true" />
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#E2E8F0"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="16dp" />

    <!-- Intervalo de monitoreo -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Intervalo de Monitoreo (segundos)"
        android:textSize="15sp"
        android:textStyle="bold"
        android:textColor="#11181C"
        android:layout_marginBottom="8dp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center"
        android:background="@drawable/bg_contact_card"
        android:padding="12dp"
        android:layout_marginBottom="8dp">
        <TextView
            android:id="@+id/tvIntervaloValue"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="30"
            android:textSize="28sp"
            android:textStyle="bold"
            android:textColor="#00796B" />
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text=" seg"
            android:textSize="16sp"
            android:textColor="#00796B" />
    </LinearLayout>

    <com.google.android.material.slider.Slider
        android:id="@+id/sliderIntervalo"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:valueFrom="5"
        android:valueTo="120"
        android:value="30"
        android:stepSize="5"
        app:thumbColor="#00796B"
        app:trackColorActive="#00796B"
        app:trackColorInactive="#E2E8F0"
        app:haloColor="#8000796B" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginBottom="4dp">
        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="5 seg"
            android:textSize="12sp"
            android:textColor="#64748B" />
        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="120 seg"
            android:textSize="12sp"
            android:textColor="#64748B"
            android:gravity="end" />
    </LinearLayout>

</LinearLayout>
