<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F7FAFA"
    android:orientation="vertical"
    android:paddingStart="24dp"
    android:paddingTop="48dp"
    android:paddingEnd="24dp"
    android:paddingBottom="32dp">

    <!-- Header -->
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="24dp">

        <ImageButton
            android:id="@+id/btnBack"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_alignParentStart="true"
            android:layout_centerVertical="true"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Atrás"
            android:src="@drawable/ic_chevron_left"
            app:tint="#11181C" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerInParent="true"
            android:text="Preparar Dispositivo"
            android:textColor="#11181C"
            android:textSize="18sp"
            android:textStyle="bold" />
    </RelativeLayout>

    <!-- Step Progress Section -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        android:layout_marginBottom="32dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Paso 1 de 3"
            android:textColor="#64748B"
            android:textSize="13sp"
            android:layout_marginBottom="8dp" />

        <ProgressBar
            android:id="@+id/progressBarStep"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="220dp"
            android:layout_height="6dp"
            android:max="100"
            android:progress="33"
            android:progressDrawable="@drawable/bg_step_progress_track" />
    </LinearLayout>

    <!-- Watch Icon Container Box -->
    <FrameLayout
        android:layout_width="110dp"
        android:layout_height="110dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginBottom="28dp"
        android:background="@drawable/bg_watch_container">

        <ImageView
            android:layout_width="54dp"
            android:layout_height="54dp"
            android:layout_gravity="center"
            android:contentDescription="Reloj"
            android:src="@drawable/reloj"
            app:tint="#00796B" />
    </FrameLayout>

    <!-- Main Title -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:layout_marginBottom="24dp"
        android:text="Enciende tu SafeBand"
        android:textColor="#11181C"
        android:textSize="22sp"
        android:textStyle="bold" />

    <!-- Numbered Step Cards Container -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Step 1 Card -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="@drawable/bg_step_card"
            android:padding="16dp"
            android:layout_marginBottom="12dp">

            <TextView
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:background="@drawable/bg_circle_number"
                android:gravity="center"
                android:text="1"
                android:textColor="#FFFFFF"
                android:textSize="15sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="14dp"
                android:text="Mantén presionado el botón superior por 5 segundos"
                android:textColor="#1E293B"
                android:textSize="14sp"
                android:textStyle="bold"
                android:lineSpacingExtra="2dp" />
        </LinearLayout>

        <!-- Step 2 Card -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="@drawable/bg_step_card"
            android:padding="16dp"
            android:layout_marginBottom="12dp">

            <TextView
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:background="@drawable/bg_circle_number"
                android:gravity="center"
                android:text="2"
                android:textColor="#FFFFFF"
                android:textSize="15sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="14dp"
                android:text="Espera a que el dispositivo vibre"
                android:textColor="#1E293B"
                android:textSize="14sp"
                android:textStyle="bold"
                android:lineSpacingExtra="2dp" />
        </LinearLayout>
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <!-- Action Buttons -->
    <!-- Button Conectar por Bluetooth BLE -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnBluetooth"
        style="@style/Widget.MaterialComponents.Button.OutlinedButton"
        android:layout_width="match_parent"
        android:layout_height="54dp"
        android:layout_marginBottom="12dp"
        android:text="Conectar por Bluetooth BLE"
        android:textAllCaps="false"
        android:textColor="#00796B"
        android:textSize="15sp"
        android:textStyle="bold"
        app:cornerRadius="27dp"
        app:strokeColor="#00796B"
        app:strokeWidth="1.5dp" />

    <!-- Button Configurar por Wi-Fi → -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnNext"
        android:layout_width="match_parent"
        android:layout_height="54dp"
        android:text="Configurar por Wi-Fi →"
        android:textAllCaps="false"
        android:textColor="#FFFFFF"
        android:textSize="16sp"
        android:textStyle="bold"
        app:backgroundTint="#00796B"
        app:cornerRadius="27dp"
        app:elevation="2dp" />

</LinearLayout>
