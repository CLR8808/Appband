<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_main"
    android:orientation="vertical"
    android:paddingStart="24dp"
    android:paddingTop="54dp"
    android:paddingEnd="24dp"
    android:paddingBottom="40dp">

    <!-- Header -->
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="40dp">

        <ImageButton
            android:id="@+id/btnBack"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_alignParentStart="true"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Atrás"
            android:src="@drawable/ic_chevron_left"
            app:tint="@color/text_primary" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerInParent="true"
            android:text="Preparar Dispositivo"
            android:textColor="@color/text_primary"
            android:textSize="22sp"
            android:textStyle="bold" />
    </RelativeLayout>

    <!-- Watch Icon Circle -->
    <FrameLayout
        android:layout_width="120dp"
        android:layout_height="120dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginBottom="32dp"
        android:background="@drawable/bg_primary_button"
        android:backgroundTint="@color/primary_bg_cyan_light">

        <ImageView
            android:layout_width="60dp"
            android:layout_height="60dp"
            android:layout_gravity="center"
            android:contentDescription="Watch"
            android:src="@drawable/reloj" />
    </FrameLayout>

    <!-- Main Title & Subtitle -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:layout_marginBottom="12dp"
        android:text="Enciende la Pulsera"
        android:textColor="@color/text_primary"
        android:textSize="24sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:layout_marginBottom="36dp"
        android:gravity="center"
        android:lineSpacingExtra="4dp"
        android:text="Mantén presionado el botón superior\ndurante 5 segundos hasta que vibre"
        android:textColor="@color/text_muted"
        android:textSize="16sp" />

    <!-- Info Box -->
    <androidx.cardview.widget.CardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="36dp"
        app:cardBackgroundColor="@color/card_bg"
        app:cardCornerRadius="14dp"
        app:cardElevation="2dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:padding="16dp"
            android:text="Conecta la pulsera a una red Wi-Fi para continuar"
            android:textColor="@color/primary_teal"
            android:textSize="14sp"
            android:textStyle="bold" />
    </androidx.cardview.widget.CardView>

    <View
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <!-- Button Conectar por Bluetooth BLE -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnBluetooth"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:text="Conectar por Bluetooth BLE"
        android:textAllCaps="false"
        android:textColor="#00BFA5"
        android:textSize="15sp"
        android:textStyle="bold"
        style="@style/Widget.MaterialComponents.Button.OutlinedButton"
        app:strokeColor="#00BFA5"
        app:cornerRadius="14dp"
        android:layout_marginBottom="12dp" />

    <!-- Button Siguiente (Wi-Fi) -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnNext"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:background="@drawable/bg_primary_button"
        android:text="Configurar por Wi-Fi →"
        android:textColor="@color/white"
        android:textSize="16sp"
        android:textStyle="bold"
        app:backgroundTint="@null"
        app:cornerRadius="14dp"
        app:elevation="6dp" />

</LinearLayout>
